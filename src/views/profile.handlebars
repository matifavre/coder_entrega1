<main class="d-flex w-100 flex-grow-1" style="padding-top: 100px !important;">
  <section class="d-flex flex-column align-items-center w-100">
    <section
      class="d-flex flex-column justify-content-center align-items-center w-25 m-3"
    >
      <h5 class="m-2 p-2 text-center">EMAIL: {{profile.email}}</h5>
      <h5 class="m-2 p-2 text-center">ROLE: {{profile.role}}</h5>
      <img
        style="width: 360px; height: 360px"
        class="m-2 object-fit-cover"
        src="{{profile.photo}}"
      />
    </section>
  </section>
</main>