<main class="d-flex w-100 flex-grow-1" style="padding-top: 100px !important;">

  <section class="d-flex flex-column align-items-center w-100">

    <div class="card w-25 p-2 d-flex" style="height: 400px;">
      <h5 class="card-title">Register a new user</h5>
      <div class="card-body d-flex justify-content-center">
        <form class="d-flex flex-column w-100">
          <input
            class="m-2 p-2 text-center"
            type="email"
            name="email"
            id="email"
            placeholder="EMAIL"
          />
          <input
            class="m-2 p-2 text-center"
            type="password"
            name="password"
            id="password"
            placeholder="PASSWORD"
          />
          <input
            class="m-2 p-2 text-center"
            type="text"
            name="photo"
            id="photo"
            placeholder="PHOTO"
          />
          <input
            class="m-2 p-2 text-center btn btn-success"
            type="button"
            id="register"
            value="Register"
          />
        </form>
      </div>
    </div>

  </section>
</main>