<main class="d-flex flex-column align-items-center w-100 flex-grow-1">

  <section class="m-3 w-100 row p-5">
    <div class="m-3 w-100">
      <form method="GET" action="/" class="form-inline justify-content-center mb-3 w-25">
      <div class="input-group mb-3">
        <div class="input-group-prepend">
          <label class="input-group-text" for="inputGroupSelect01">Options</label>
        </div>
        <select name="category" class="custom-select" onchange="this.form.submit()">
          <option value="">All Categories</option>
          {{#each categories}}
          <option value="{{this}}" {{#ifEquals ../selectedCategory this}}selected{{/ifEquals}}>{{this}}</option>
          {{/each}}
        </select>
      </div>
      </form>
    </div>
    {{#each products}}
      <div class="col-3 p-2">
        <div class="card mb-4">
          <img class="card-img-top" src={{this.photo}} alt="Card image cap" />
          <div class="card-body p-3">
            <h5 class="card-title">{{this.title}}</h5>
            <p class="card-text">{{this.category}}</p>
            <p class="card-text">Available Stock: {{this.stock}}</p>
            <h4 class="font-weight-bold text-center pt-3">${{this.price}}</h4>
            <div
              class="d-flex justify-content-center align-items-center w-100 p-3"
            >
              <a
                href="/products/{{this.id}}"
                class="mt-2 p-2 text-center btn btn-success"
              >SEE PRODUCT</a>
            </div>
          </div>
        </div>
      </div>
    {{/each}}
  </section>
</main>